# Frontend environment variables
# Copy to .env and modify as needed.

# API base URL — used by frontend fetch calls.
#
# LOCAL DEVELOPMENT:
#   Vite proxy handles /api → http://127.0.0.1:8000
#   Keep as /api (default).
VITE_API_BASE_URL=/api

# PRODUCTION (Vercel):
#   Set to the deployed Render backend URL:
#   VITE_API_BASE_URL=https://polarops-api.onrender.com
