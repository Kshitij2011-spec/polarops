# ==============================================================================
# PolarOps .gitignore
# ==============================================================================

# --- Dependencies ---
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
!.env.example

# --- Databases (Local SQLite) ---
*.db
*.sqlite3

# --- Build Outputs ---
dist/
build/
.output/
.vinxi/
*.tsbuildinfo
node_modules/.tmp/

# --- IDE & Editor Artifacts ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-*
.claude/

# --- Operating System Artifacts ---
.DS_Store
Thumbs.db
desktop.ini

# --- Python Tooling Caches ---
.pytest_cache/
htmlcov/
coverage/
*.cover
.mypy_cache/
.ruff_cache/

# --- Test Artifacts & Playwright ---
test-results/
playwright-report/
blob-report/
.playwright-mcp/
**/test-results/
**/playwright-report/

# --- Images & Documentation Assets ---
# Exclude root scratch screenshots, historical integration captures, and test outputs
/*.png
**/test-results/**/*.png
**/playwright-report/**/*.png
docs/integration/screenshots/

# Explicitly allow documentation screenshots
!docs/screenshots/*.png

# --- Code Analysis, Graphify & Agent Caches ---
graphify-out/
.lovable/
brag-output/
brag-output-*/
skills-lock.json

# --- Temporary & Log Files ---
*.log
*.tmp
*.bak
