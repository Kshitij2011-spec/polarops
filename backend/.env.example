# Backend environment configuration
# Copy this file to .env and fill in values as needed.

# --- Application ---
APP_NAME=polarops-api
DEBUG=true
PORT=8000

# --- CORS ---
# In production, set FRONTEND_ORIGIN to the deployed frontend URL.
# FRONTEND_ORIGIN=https://polarops.vercel.app

# --- Database ---
# For local development with SQLite (default):
DATABASE_URL=sqlite:///./polarops_dev.db
# For PostgreSQL / Supabase / Render:
# DATABASE_URL=postgresql://user:password@host:5432/polarops

# --- Supabase (optional) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
