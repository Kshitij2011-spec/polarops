# Backend environment configuration
# Copy this file to .env and fill in values as needed.

# --- Application ---
APP_NAME=polarops-api
DEBUG=true
PORT=8000

# --- CORS ---
# In production, set FRONTEND_ORIGIN to the deployed frontend URL.
# FRONTEND_ORIGIN=https://polarops.vercel.app

# --- Database ---
# For local development with SQLite (default):
DATABASE_URL=sqlite:///./polarops_dev.db
# For PostgreSQL / Supabase / Render:
# DATABASE_URL=postgresql://user:password@host:5432/polarops

# --- Supabase (optional) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Mailgun & Visitor Alerts (optional) ---
# When configured, sends privacy-minimal anonymous session alerts to the owner.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=sandboxd3ff4971473e4310b5ddc987a096bdd5.mailgun.org
MAILGUN_RECIPIENT_EMAIL=
MAILGUN_FROM=postmaster@sandboxd3ff4971473e4310b5ddc987a096bdd5.mailgun.org
MAILGUN_API_URL=https://api.mailgun.net/v3
ALERT_COOLDOWN_MINUTES=15
SESSION_TIMEOUT_MINUTES=10

